GROQ_API_KEY=your_groq_api_key_here
# A second key only adds capacity if it belongs to a DIFFERENT Groq account:
# the TPM budget is shared per organisation, so a same-org key buys nothing.
GROQ_API_KEY_FALLBACK=optional_second_groq_api_key
# The agent rotates models on a daily-quota 429, since TPD is enforced per model.
GROQ_MODEL=openai/gpt-oss-20b

# Composio (https://app.composio.dev) — primary search + page-fetch tools.
# NOTE: this project calls Composio's hosted MCP endpoint with the
# `x-consumer-api-key` header, NOT the `composio` PyPI SDK's REST client.
# Falls back to DuckDuckGo/LangSearch if unset.
COMPOSIO_API_KEY=your_composio_api_key_here

# Optional: LangSearch (https://langsearch.com) web search + inline full-text extraction.
# Free tier, more reliable than the DuckDuckGo fallback. Falls back to DuckDuckGo if unset.
LANGSEARCH_API_KEY=your_langsearch_api_key_here

LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
